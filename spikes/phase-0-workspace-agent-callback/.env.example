# Threadline Phase 0 feasibility spike — environment template.
# Copy to `.env` and fill with TEST/STAGING values only. NEVER commit a real .env.
# No production credentials, no real phone numbers, no owner sender identifiers.

# --- OpenAI Workspace Agent trigger (live gate) ---
# The published agent's API channel id (agtch_XXX) and a Workspace Agent scoped
# access token (Admin > Access tokens > "Workspace Agents" scope). This is NOT an
# OpenAI Platform API key, and the endpoint is api.chatgpt.com — not api.openai.com.
THREADLINE_WA_TRIGGER_ID=agtch_replace_me
THREADLINE_WA_ACCESS_TOKEN=replace_me
THREADLINE_OPENAI_BASE_URL=https://api.chatgpt.com/v1

# --- Secure MCP Tunnel (live gate) ---
# tunnel_id from Platform tunnel settings; a runtime API key with Tunnels
# Read+Use. The tunnel-client binary must be running and pointed at the local
# MCP server port below. NOTE: tunnel support for a Workspace Agent's custom MCP
# is UNVERIFIED (see PHASE-0.md, assumption OA-TUNNEL-WA); prove it in the gate.
THREADLINE_TUNNEL_ID=replace_me
THREADLINE_OPENAI_RUNTIME_API_KEY=replace_me

# --- Photon / Spectrum (live gate) ---
# Spectrum Cloud project id + secret (app.photon.codes) for the TEST line/space.
# Webhook secret only if you consume the webhook ingress path.
THREADLINE_PHOTON_PROJECT_ID=replace_me
THREADLINE_PHOTON_PROJECT_SECRET=replace_me
THREADLINE_PHOTON_WEBHOOK_SECRET=replace_me

# --- Spike server ---
THREADLINE_MCP_PORT=8787
THREADLINE_MAX_TEXT=4000
THREADLINE_SQLITE_PATH=./phase0.sqlite

# Shared bearer the MCP callback edge requires in addition to the tunnel.
THREADLINE_CALLBACK_AUTH_TOKEN=replace_me
